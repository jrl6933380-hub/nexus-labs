{
  "env": {
    "NEX_QWEN_ONLY": "true"
  },
  "functions": {
    "api/nexus-messages.js": {
      "maxDuration": 300
    },
    "api/team-sweep.js": {
      "maxDuration": 300
    },
    "api/room-chat.js": {
      "maxDuration": 300
    },
    "api/research-sweep.js": {
      "maxDuration": 60
    },
    "api/doc-extract.js": {
      "maxDuration": 60
    },
    "api/nexus-lab.js": {
      "maxDuration": 300
    },
    "api/nexus-lab-sweep.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/ad-maker.html",
      "destination": "/ads.html",
      "permanent": false
    },
    {
      "source": "/workspace-key-setup.html",
      "destination": "/workspace-connection-guide.html",
      "permanent": false
    },
    {
      "source": "/mission-control.html",
      "destination": "/workspace.html?view=deck",
      "permanent": true
    },
    {
      "source": "/conference-room.html",
      "destination": "/workspace.html?view=agents",
      "permanent": true
    },
    {
      "source": "/memory.html",
      "destination": "/workspace.html?view=memory",
      "permanent": true
    },
    {
      "source": "/queue.html",
      "destination": "/workspace.html?view=approvals",
      "permanent": true
    },
    {
      "source": "/connectors.html",
      "destination": "/workspace.html?view=skills",
      "permanent": true
    },
    {
      "source": "/tenants.html",
      "destination": "/workspace.html?view=forge",
      "permanent": true
    },
    {
      "source": "/nexus-canvas.html",
      "destination": "/workspace.html?view=messages",
      "permanent": true
    },
    {
      "source": "/thoughtspace.html",
      "destination": "/workspace.html?view=messages",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/waitlist?preview=:id"
    },
    {
      "source": "/intelligence",
      "destination": "/intelligence.html"
    },
    {
      "source": "/connect",
      "destination": "/connect.html"
    },
    {
      "source": "/authorize",
      "destination": "/api/workspace-oauth?route=authorize"
    },
    {
      "source": "/token",
      "destination": "/api/workspace-oauth?route=token"
    },
    {
      "source": "/register",
      "destination": "/api/workspace-oauth?route=register"
    },
    {
      "source": "/revoke",
      "destination": "/api/workspace-oauth?route=revoke"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/workspace-oauth?route=metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/workspace-mcp",
      "destination": "/api/workspace-oauth?route=resource"
    },
    {
      "source": "/api/hyperfocus",
      "destination": "/api/board"
    },
    {
      "source": "/api/agentlog",
      "destination": "/api/board"
    },
    {
      "source": "/api/vault",
      "destination": "/api/board"
    },
    {
      "source": "/api/availability",
      "destination": "/api/board"
    },
    {
      "source": "/api/life",
      "destination": "/api/board"
    },
    {
      "source": "/api/reminders",
      "destination": "/api/board"
    },
    {
      "source": "/api/push",
      "destination": "/api/board"
    },
    {
      "source": "/api/alerts",
      "destination": "/api/board"
    },
    {
      "source": "/api/push-deliver",
      "destination": "/api/board"
    },
    {
      "source": "/api/social-auth",
      "destination": "/api/board"
    },
    {
      "source": "/api/social-auth/callback/:provider",
      "destination": "/api/board"
    },
    {
      "source": "/api/account",
      "destination": "/api/board"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/board"
    },
    {
      "source": "/api/planner",
      "destination": "/api/board"
    },
    {
      "source": "/api/pinned-visuals",
      "destination": "/api/board"
    },
    {
      "source": "/api/nex/action",
      "destination": "/api/board"
    },
    {
      "source": "/api/sentry-webhook",
      "destination": "/api/board"
    },
    {
      "source": "/api/tenants",
      "destination": "/api/board"
    },
    {
      "source": "/api/oauth/:provider/callback",
      "destination": "/api/board"
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/memory-curate",
      "schedule": "17 6 * * *"
    },
    {
      "path": "/api/forge-sweep",
      "schedule": "23 * * * *"
    },
    {
      "path": "/api/push-deliver",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/alerts?sweep=1",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/team-sweep",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/research-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/nexus-lab-sweep",
      "schedule": "*/2 * * * *"
    }
  ]
}

